{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desk_tauri",
  "version": "0.1.2",
  "identifier": "com.dax.desk_tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "desk_tauri",
        "width": 1420,
        "height": 880,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
