{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zera Desktop",
  "version": "0.1.0",
  "identifier": "com.dax.desk-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zera Desktop",
        "width": 1420,
        "height": 880,
        "decorations": false,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Hayden Porter-Aylor (9HD4Q82U58)"
    }
  }
}
